\ProvidesPackage{acmpaper}
%
% Import definitions common to all styles.
%
\usepackage{latex_styles_common0}
\usepackage{latex_styles_common}

\usepackage{subdepth}  % Equalize depth of subscripts. Amazing!
% Backrefs for the bibliography.
%
\usepackage[hyperpageref]{backref}
\renewcommand*{\backref}[1]{}% for backref < 1.33 necessary
\renewcommand*{\backrefalt}[4]{%
	\ifcase #1 %
		No citations.%
	\or
		\marginpar{\tiny cited on p. #2}%
	\else
		\marginpar{\tiny cited on pp. #2}%
	\fi
}
%
% Page styles.
%
\def\ps@firstpage{%\ps@plain
\def\@oddfoot{\normalfont\scriptsize \hfil\thepage\hfil\@gitline}%
     %\global\topskip\normaltopskip}%
  \let\@evenfoot\@oddfoot
  \def\@oddhead{\hfil\normalfont\small\@cahierline}%
  \let\@evenhead\@oddhead % in case an article starts on a left-hand page
}

\def\ps@geradheadings{%
    \def\@oddfoot{\normalfont\scriptsize\ttfamily\@cahierline\hfil\@gitline}
    \def\@evenfoot{\normalfont\scriptsize\ttfamily\@gitline\hfil\@cahierline}
    \def\@evenhead{\rlap{\thepage}\hfil\upshape\footnotesize\@shortauthors\hfil\scshape\hyperlink{contents}{[toc]}}%
    \def\@oddhead{\footnotesize\scshape\hyperlink{contents}{[toc]}\hfil{\upshape\footnotesize\shorttitle}\hfil\llap{\thepage}}%
    \let\@mkboth\@gobbletwo
    \let\sectionmark\@gobble
    \let\subsectionmark\@gobble
    }
